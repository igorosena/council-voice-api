# Bearer token required on every route except /health. Leave empty to disable auth.
COUNCIL_API_KEY=change-me-to-a-long-random-string
# auto | cuda | mps | cpu
COUNCIL_DEVICE=auto
# Load the model at startup (1) or on first request (0)
COUNCIL_PRELOAD=1
COUNCIL_DEFAULT_LANGUAGE=pt
COUNCIL_DEFAULT_FORMAT=mp3
# Diffusion steps: 16 = fast, 32 = best quality
COUNCIL_NUM_STEP=16
# Hugging Face token only if your network needs it (model is public)
HF_TOKEN=
# Clean reference clips (denoise + dereverb) with DeepFilterNet on registration
COUNCIL_CLEAN_REFS=1
# Only needed when deepfilternet lives in another venv (Mac dev): path to its python
COUNCIL_DFN_PYTHON=
